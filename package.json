{
  "name": "pulse-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Pulse \u2014 a cross-platform health tracker demo: React front end, Express + SQLite back end",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "seed": "npm run seed --workspace server",
    "start": "npm run build && npm run start --workspace server",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
